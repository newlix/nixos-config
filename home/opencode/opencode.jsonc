{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "fable",
  "permission": {
    "edit": "allow",
    "bash": { "*": "allow", "sudo *": "ask", "rm -rf /*": "ask" },
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "zai-vision": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server"],
      "enabled": true,
      "environment": {
        "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    }
  }
}
